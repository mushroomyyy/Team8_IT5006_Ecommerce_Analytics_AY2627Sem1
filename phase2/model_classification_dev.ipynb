                    },
                    {
                              "cell_type": "code",
                              "execution_count": 12,
                              "id": "baseline-lr",
                              "metadata": {
                                        "execution": {
                                                  "iopub.execute_input": "2026-10-04T13:00:02.053679Z",
                                                  "iopub.status.busy": "2026-10-04T13:00:02.053598Z",
                                                  "iopub.status.idle": "2026-10-04T13:00:02.510539Z",
                                                  "shell.execute_reply": "2026-10-04T13:00:02.510037Z"
                                        }
                              },
                              "outputs": [
                                        {
                                                  "name": "stdout",
                                                  "output_type": "stream",
                                                  "text": [
                                                            "Logistic Regression Pipeline trained!\n"
                                                  ]
                                        }
                              ],
                              "source": [
                                        "# Baseline with class balancing; preprocessing is fitted on training data only.\n",
                                        "lr_preprocessor = ColumnTransformer([\n",
                                        "    ('numeric', Pipeline([\n",
                                        "        ('imputer', SimpleImputer(strategy='median')),\n",
                                        "        ('scaler', StandardScaler()),\n",
                                        "    ]), NUM_COLS),\n",
                                        "    ('categorical', OneHotEncoder(handle_unknown='ignore'), CAT_COLS),\n",
                                        "])\n",
                                        "lr_pipeline = Pipeline([\n",
                                        "    ('preprocessor', lr_preprocessor),\n",
                                        "    ('classifier', LogisticRegression(\n",
                                        "        class_weight='balanced', max_iter=1000, random_state=42,\n",
                                        "    )),\n",
                                        "])\n",
                                        "lr_pipeline.fit(X_train, y_train)\n",
                                        "print('Logistic Regression Pipeline trained!')"
                              ]
                    },
                    {
                              "cell_type": "markdown",
                              "id": "baseline-decision-tree-heading",
                              "metadata": {},
                              "source": [
                                        "## Decision Tree"
