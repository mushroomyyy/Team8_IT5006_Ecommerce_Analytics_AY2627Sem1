    "        train_end_date,\n",
    "        inclusive='both'\n",
    "    )\n",
    "].copy()\n",
    "\n",
    "# Exclude the 45 approval days before development validation.\n",
    "holdout_start = pd.Timestamp(test_start_date)\n",
    "train_df = train_df.loc[train_df['order_approved_dt'].lt(\n",
    "    holdout_start - pd.Timedelta(days=LOOKBACK))].copy()\n",
    "# A gap alone cannot guarantee that every classification label was known.\n",
    "holdout_train_audit = labels_as_of(train_df, test_start_date)\n",
    "known = holdout_train_audit['label_as_of_run']\n",
    "train_df = train_df.loc[(known.notna() & known.eq(train_df[LABEL_COL])).fillna(False)].copy()\n",
    "assert not train_df.empty\n",
    "assert (holdout_start - train_df['order_approved_dt'].max()).days > LOOKBACK\n",
    "\n",
    "train_df = train_df.sort_values('order_approved_dt', kind='stable')\n",
    "X_train, y_train = train_df[FEATURE_COLS], train_df[LABEL_COL]\n",
