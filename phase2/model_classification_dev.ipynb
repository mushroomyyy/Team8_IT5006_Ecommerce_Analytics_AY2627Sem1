   },
   "outputs": [
    {
     "name": "stdout",
     "output_type": "stream",
     "text": [
      "\n",
      "Data split complete:\n",
      "   Training: 45,972 samples (8.83% late)\n",
      "   Test:     6,870 samples (10.38% late)\n"
     ]
    }
   ],
   "source": [
    "train_df = train_test_label[\n",
    "    train_test_label['order_approved_dt'].between(\n",
