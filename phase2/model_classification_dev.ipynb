                                        "\n",
                                        "cv_folds = day_blocked_time_series_folds(\n",
                                        "    cv_train_df['order_approved_dt'], n_splits=N_CV_FOLDS, gap_days=LOOKBACK)\n",
                                        "cv_folds = available_outcome_folds(\n",
                                        "    cv_train_df, cv_folds, y_cv_train, labels_as_of, 'label_as_of_run')\n",
