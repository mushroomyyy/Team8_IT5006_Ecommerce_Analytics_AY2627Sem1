                              "source": [
                                        "# Preprocessor\n",
                                        "- Missing numeric values are handled inside each model pipeline using training medians for Logistic Regression, Decision Tree, XGBoost, Random Forest and LightGBM."
                              ]
                    },
                    {
                              "cell_type": "code",
                              "execution_count": 11,
                              "id": "e64a4f2c",
                              "metadata": {
                                        "execution": {
                                                  "iopub.execute_input": "2026-10-04T13:00:02.050508Z",
                                                  "iopub.status.busy": "2026-10-04T13:00:02.050363Z",
                                                  "iopub.status.idle": "2026-10-04T13:00:02.052582Z",
                                                  "shell.execute_reply": "2026-10-04T13:00:02.052109Z"
                                        }
                              },
                              "outputs": [],
                              "source": [
                                        "# Fit numeric medians and category mappings on training data inside each pipeline.\n",
                                        "preprocessor = ColumnTransformer(\n",
                                        "    transformers=[\n",
                                        "        ('numeric', SimpleImputer(strategy='median'), NUM_COLS),\n",
                                        "        ('categorical', OneHotEncoder(handle_unknown='ignore'), CAT_COLS)\n",
                                        "    ],\n",
                                        "    sparse_threshold=0  # Keep a dense matrix for the tree models\n",
                                        ")"
                              ]
                    },
                    {
