                              "source": [
                                        "rf_classifier = RandomForestClassifier(\n",
                                        "    n_estimators=100,           # Number of trees in the forest\n",
                                        "    max_depth=10,               # Maximum tree depth\n",
                                        "    class_weight='balanced',    # Auto-adjust weights inversely to class freq\n",
                                        "    random_state=42,\n",
