                                        {
                                                  "name": "stdout",
                                                  "output_type": "stream",
                                                  "text": [
                                                            "Smallest candidate meeting 99.0% in every run and scope: 45 days. Note that this is only historical evidence and not a future guarantee.\n"
                                                  ]
