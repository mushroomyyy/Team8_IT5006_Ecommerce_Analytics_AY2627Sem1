    "        test_end_date,\n",
    "        inclusive='both'\n",
    "    )\n",
    "].copy()\n",
    "X_test, y_test = test_df[FEATURE_COLS], test_df[LABEL_COL]\n",
    "\n",
    "print(f\"\\nData split complete:\")\n",
    "print(f\"   Training: {len(X_train):,} samples ({y_train.mean()*100:.2f}% late)\")\n",
    "print(f\"   Test:     {len(X_test):,} samples ({y_test.mean()*100:.2f}% late)\")"
