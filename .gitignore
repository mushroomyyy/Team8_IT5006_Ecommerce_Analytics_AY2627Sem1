# Python environments and generated files
**/.venv/
**/.venv-*/
__pycache__/
*.py[cod]

# macOS
.DS_Store

# Local Streamlit secrets
**/.streamlit/secrets.toml

# Extracted Olist CSVs and generated predictions stay local; the bundled ZIP is tracked
*.csv
