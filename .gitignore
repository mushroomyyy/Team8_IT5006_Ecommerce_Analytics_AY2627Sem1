/phase2/test_classification_eval.py

# Publish report summary CSVs; keep prediction caches and working prose local
!/results/report_tables/*.csv
/results/report_tables/*predictions.csv
/results/report_tables/CV_HYPERPARAMETER_PROSE.md

# Retired notebooks/tests under the reorganized layout
/notebooks/classification_evaluation.ipynb
/tests/phase2/test_classification_eval.py
