FROM python:3.13.5-slim
WORKDIR /app
ENV PYTHONUNBUFFERED=1 PORT=10000
COPY deployment/classification_requirements.txt deployment/classification_backend_constraints.txt deployment/
RUN pip install --no-cache-dir -r deployment/classification_requirements.txt -c deployment/classification_backend_constraints.txt
COPY deployment/ deployment/
EXPOSE 10000
CMD ["sh", "-c", "python -m uvicorn deployment.classification_api:app --host 0.0.0.0 --port ${PORT}"]
